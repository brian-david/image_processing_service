# Copy this file to .env and change the values. Use only letters, numbers, dashes
# and underscores in values: Docker Compose and Node read .env differently, and
# characters like " $ # can end up as different values in each.
# DATABASE_URL must use the same user, password and database as the POSTGRES_ lines.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=image_service

RUSTFS_ACCESS_KEY=imageapp
RUSTFS_SECRET_KEY=pick-something-here

DATABASE_URL=postgresql://app:change-me@localhost:5432/image_service
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=images
